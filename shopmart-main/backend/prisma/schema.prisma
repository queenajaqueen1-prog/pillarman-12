generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid()) @db.VarChar(30)
  name           String
  email          String   @unique @db.VarChar(254)
  googleId       String?  @unique @db.VarChar(191)
  phone          String?  @db.VarChar(40)
  profileImage   String   @default("") @db.VarChar(2048)
  password       String
  role           String   @default("customer") @db.VarChar(20)
  sellerCode     String?  @unique @db.VarChar(40)
  sellerApproved Boolean  @default(true)
  isActive       Boolean  @default(true)
  tokenVersion   Int      @default(0)
  walletBalance  Float    @default(0)
  addresses      Json
  wishlist       Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  products       Product[]
  customerOrders Order[]  @relation("CustomerOrders")
  reviews        ProductReview[]
  campaigns      NewsletterCampaign[]
  infoPages      InfoPage[]
  resetToken     PasswordResetToken?

  @@index([role, createdAt])
}

model Product {
  id                       String   @id @default(cuid()) @db.VarChar(30)
  title                    String   @db.VarChar(255)
  category                 String   @db.VarChar(120)
  subcategory              String   @default("T-Shirts") @db.VarChar(120)
  brand                    String   @db.VarChar(120)
  price                    Float
  originalPrice            Float
  specialDiscountPercentage Float  @default(0)
  discountPercentage       Float    @default(0)
  rating                   Float    @default(0)
  numReviews               Int      @default(0)
  images                   Json
  sizes                    Json
  colors                   Json
  colorImages              Json
  description              String   @db.Text
  specifications           Json
  stock                    Int      @default(10)
  sellerId                 String   @db.VarChar(30)
  seller                   User     @relation(fields: [sellerId], references: [id])
  reviews                  ProductReview[]
  specialDeals             SpecialDeal[]
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([category])
  @@index([sellerId])
  @@index([createdAt])
}

model Category {
  id        String   @id @default(cuid()) @db.VarChar(30)
  name      String   @unique @db.VarChar(120)
  slug      String?  @db.VarChar(160)
  icon      String?  @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id                      String   @id @default(cuid()) @db.VarChar(30)
  customerId              String   @db.VarChar(30)
  customer                User     @relation("CustomerOrders", fields: [customerId], references: [id])
  items                   Json
  shippingAddress         Json
  subtotal                Float
  deliveryFee             Float    @default(0)
  discountAmount          Float    @default(0)
  couponCode              String?  @db.VarChar(80)
  totalAmount             Float
  orderStatus             String   @default("Processing") @db.VarChar(30)
  paymentInfo             Json
  confirmationEmailSentAt DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([customerId, createdAt])
  @@index([orderStatus, createdAt])
}

model Banner {
  id          String   @id @default(cuid()) @db.VarChar(30)
  eyebrow     String   @db.VarChar(32)
  title       String   @db.VarChar(80)
  description String   @default("") @db.VarChar(180)
  buttonLabel String   @db.VarChar(24)
  link        String   @db.VarChar(200)
  imageUrl    String   @db.VarChar(2048)
  imageAlt    String   @db.VarChar(120)
  placement   String   @default("side") @db.VarChar(20)
  theme       String   @default("blue") @db.VarChar(20)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, placement, sortOrder])
}

model Coupon {
  id                  String   @id @default(cuid()) @db.VarChar(30)
  code                String   @unique @db.VarChar(80)
  discountPercentage Float
  maxDiscountAmount  Float    @default(500)
  minOrderAmount     Float    @default(0)
  startDate          DateTime?
  expiryDate         DateTime
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ProductReview {
  id        String   @id @default(cuid()) @db.VarChar(30)
  productId String   @db.VarChar(30)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String  @db.VarChar(30)
  customer  User     @relation(fields: [customerId], references: [id])
  rating    Int
  comment   String   @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, customerId])
  @@index([productId, createdAt])
}

model SpecialDeal {
  id                 String   @id @default(cuid()) @db.VarChar(30)
  title              String   @db.VarChar(80)
  productId          String   @db.VarChar(30)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountPercentage Float
  startsAt           DateTime
  endsAt             DateTime
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([productId, isActive, startsAt, endsAt])
}

model InfoPage {
  id        String   @id @default(cuid()) @db.VarChar(30)
  slug      String   @unique @db.VarChar(80)
  title     String   @db.VarChar(120)
  intro     String   @db.VarChar(1000)
  sections  Json
  updatedById String? @db.VarChar(30)
  updatedBy User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id           String   @id @default(cuid()) @db.VarChar(30)
  email        String   @unique @db.VarChar(254)
  isSubscribed Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isSubscribed, createdAt])
}

model NewsletterCampaign {
  id             String   @id @default(cuid()) @db.VarChar(30)
  subject        String   @db.VarChar(160)
  message        String   @db.Text
  banner         Json
  status         String   @default("queued") @db.VarChar(20)
  audienceCount  Int      @default(0)
  processedCount Int      @default(0)
  sentCount      Int      @default(0)
  failedCount    Int      @default(0)
  skippedCount   Int      @default(0)
  lastError      String?  @db.VarChar(240)
  createdById    String   @db.VarChar(30)
  createdBy      User     @relation(fields: [createdById], references: [id])
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String   @unique @db.VarChar(30)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @db.VarChar(128)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
